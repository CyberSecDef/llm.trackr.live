APP_NAME=LLM-Viz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Public-facing link to the source repository.
# Surfaced in the page footer per AGPL §13 (interaction-with-source obligation).
APP_REPO_URL=https://github.com/CyberSecDef/llm.trackr.live

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────
# Social authentication (M2). Leave blank in environments that don't
# use a given provider; the Socialite redirect will only be exposed
# when both *_CLIENT_ID and *_CLIENT_SECRET are present.
# ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT=common

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# ─────────────────────────────────────────────────────────────────────
# WebSocket broadcasting via Laravel Reverb (M6).
# Resolved 2026-05-18 (originally Soketi); see docs/parked-decisions.md.
# Reverb speaks the Pusher protocol so the frontend still uses pusher-js
# + Laravel Echo. App id/key/secret are generated by `php artisan reverb:install`
# or can be any random strings — they're shared secrets between server + client.
# ─────────────────────────────────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Mirror keys for Vite/Echo on the frontend.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─────────────────────────────────────────────────────────────────────
# Model registry refresh upstream (M3).
# ─────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─────────────────────────────────────────────────────────────────────
# Observability (M1, chunk 4).
# DSNs left blank → SDK is installed but no-ops, so dev/local stays quiet.
# ─────────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT="${APP_ENV}"

VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"

# ─────────────────────────────────────────────────────────────────────
# Export rendering (M10). 'svg' is the default; 'puppeteer' requires
# a separate Chromium install on the host.
# ─────────────────────────────────────────────────────────────────────
GIF_RENDERER=svg
PUPPETEER_EXECUTABLE_PATH=

# ─────────────────────────────────────────────────────────────────────
# Rate limiting defaults (M2). Per-user max can be overridden via the
# users.max_runs_per_hour column from the admin UI.
# ─────────────────────────────────────────────────────────────────────
DEFAULT_MAX_RUNS_PER_HOUR=30
