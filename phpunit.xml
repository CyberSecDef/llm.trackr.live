<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!--
            M13 chunk 1 follow-up: pin APP_URL deterministically so
            URL-asserting tests don't read whatever's in the dev
            `.env` (e.g. http://localhost:8001 when the dev server
            runs on a non-standard port). The export-trigger
            cache-hit test was the canary; expect more if URLs
            ever land in JSON assertions.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            BROADCAST_CONNECTION=pusher in tests so the channel-auth
            endpoint actually runs the registered callback (the default
            'log' driver no-ops on auth() and returns 403 for everything).
            The pusher driver only signs the response with the secret,
            so fake test creds work fine — no network is required.
        -->
        <env name="BROADCAST_CONNECTION" value="pusher"/>
        <env name="PUSHER_APP_ID" value="test-app-id"/>
        <env name="PUSHER_APP_KEY" value="test-app-key"/>
        <env name="PUSHER_APP_SECRET" value="test-app-secret"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
